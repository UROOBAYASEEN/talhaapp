const CHART_DATA = [38, 55, 42, 70, 46, 82, 63, 88, 96];
const CHART_H = 130;

function RevenueChart() {
  const chartW = width - 64;
  const min = Math.min(...CHART_DATA);
  const max = Math.max(...CHART_DATA);
  const pad = { top: 12, bottom: 8 };
  const innerH = CHART_H - pad.top - pad.bottom;

  const getX = (i: number) => (i / (CHART_DATA.length - 1)) * chartW;
  const getY = (v: number) =>
    pad.top + innerH - ((v - min) / (max - min)) * innerH;

  const linePath = CHART_DATA.map((v, i) =>
    `${i === 0 ? "M" : "L"} ${getX(i).toFixed(1)} ${getY(v).toFixed(1)}`
  ).join(" ");

  const fillPath =
    linePath +
    ` L ${getX(CHART_DATA.length - 1).toFixed(1)} ${CHART_H} L 0 ${CHART_H} Z`;

  const gridYs = [0.2, 0.45, 0.7, 0.9];

  return (
    <View style={{ marginTop: 8 }}>
      <Svg width={chartW} height={CHART_H}>
        <Defs>
          <SvgGradient id="areaGrad" x1="0" y1="0" x2="0" y2="1">
            <Stop offset="0%" stopColor="#FF6B00" stopOpacity="0.35" />
            <Stop offset="100%" stopColor="#FF6B00" stopOpacity="0" />
          </SvgGradient>
        </Defs>

        {/* Grid lines */}
        {gridYs.map((p, i) => (
          <Line
            key={i}
            x1="0"
            y1={(p * CHART_H).toFixed(1)}
            x2={chartW}
            y2={(p * CHART_H).toFixed(1)}
            stroke="rgba(100,130,180,0.15)"
            strokeWidth="1"
          />
        ))}

        {/* Fill area */}
        <Path d={fillPath} fill="url(#areaGrad)" />

        {/* Line */}
        <Path
          d={linePath}
          stroke="#FF6B00"
          strokeWidth="2.5"
          fill="none"
          strokeLinecap="round"
          strokeLinejoin="round"
        />

        {/* Data points */}
        {CHART_DATA.map((v, i) => (
          <Circle
            key={i}
            cx={getX(i)}
            cy={getY(v)}
            r="4"
            fill="#071A40"
            stroke="#FF6B00"
            strokeWidth="2"
          />
        ))}
      </Svg>
    </View>
  );
}

function BottomItem({
  icon,
  label,
  active = false,
}: {
  icon: string;
  label: string;
  active?: boolean;
}) {
  return (
    <TouchableOpacity style={styles.bottomItem}>
      <View
        style={[
          styles.bottomIcon,
          active && styles.activeBottomIcon,
        ]}
      >
        <MaterialCommunityIcons
          name={icon as any}
          size={21}
          color={active ? ORANGE : "#AEB9D0"}
        />
      </View>

      <Text
        style={[
          styles.bottomLabel,
          active && styles.activeBottomLabel,
        ]}
      >
        {label}
      </Text>
    </TouchableOpacity>
  );
}

